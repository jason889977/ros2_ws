# Docker 镜像标签：模块名_日期_版本号
APRILTAG_IMAGE=apriltag_pose_reader_20260818_v1.0
APRILTAG_CONTAINER_NAME=apriltag_pose_reader

# ROS 2 DDS 域；同一机器人部署应保持一致
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 上游相机图像和 camera_info
IMAGE_TOPIC=/my_camera/pylon_ros2_camera_node/image_raw
CAMERA_INFO_TOPIC=/my_camera/pylon_ros2_camera_node/camera_info

# 是否同时启动 apriltag_ros 检测节点
START_DETECTOR=true

# AprilTag 参数
TAG_FAMILY=36h11
TAG_ID=-1
LOOKUP_PARENT_FRAME=
LOOKUP_RATE_HZ=0.0
