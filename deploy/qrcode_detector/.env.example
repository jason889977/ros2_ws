# Docker 镜像标签：模块名_日期_版本号
QR_IMAGE=qrcode_detector_20260818_v1.0
QR_CONTAINER_NAME=qrcode_detector

# ROS 2 DDS 域；同一机器人部署应保持一致
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 输入图像来源，默认为 Basler 相机节点输出
IMAGE_TOPIC=/my_camera/pylon_ros2_camera_node/image_raw

# WeChat QR 模型目录；为空时自动使用包内默认路径
MODEL_DIR=

# 是否优先加载 WeChatQR；默认关闭，走 OpenCV fallback
PREFER_WECHAT_QR=false

# 订阅队列长度
QUEUE_SIZE=10
