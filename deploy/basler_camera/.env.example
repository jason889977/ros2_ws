# Docker 镜像标签：模块名_日期_版本号
BASLER_IMAGE=basler_camera_20260819_v2.0
BASLER_CONTAINER_NAME=basler_camera

# ROS 2 DDS 域；同一机器人上的容器和宿主机应保持一致
ROS_DOMAIN_ID=0
# DDS 实现
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ============================================================
# Camera 1
# ============================================================
CAMERA_ID=my_camera
CAMERA_CONFIG_FILE=/opt/ros2_ws/deploy/basler_camera/config/aca2500_106611_18.yaml
CAMERA_MTU_SIZE=1500
CAMERA_STARTUP_USER_SET=Default
CAMERA_RESPAWN=true
# 容器启动时等待 camera_info 的最大秒数；超时会退出容器并报错（相机占用/未连接）
CAMERA_STARTUP_TIMEOUT_S=120

# Per-module enable flags (camera 1)
ENABLE_APRILTAG=true
ENABLE_KEYENCE=true
ENABLE_WEB_DASHBOARD=true

# Scanner settings (camera 1)
SCANNER_IP=172.31.0.91
SCANNER_PORT=9004
RECONNECT_INTERVAL_S=5.0

# Web dashboard port (Dashboard listens on localhost by default)
WEB_PORT=8080

# Persistent event logs and dashboard snapshot archive
ARCHIVE_DIR=/var/lib/vision/archive
EVENT_LOG_DIR=/var/log/vision
CALIBRATION_DIR=/var/lib/vision/calibration

# Optional Hand-Eye & World-Base static TF anchor
# HANDEYE_CALIBRATION_FILE=/opt/ros2_ws/deploy/basler_camera/config/handeye.yaml
# WORLD_FRAME=world
# BASE_FRAME=base_link
