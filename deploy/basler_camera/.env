# Docker 镜像标签：模块名_日期_版本号
BASLER_IMAGE=basler_camera_20260819_v2.0
BASLER_CONTAINER_NAME=basler_camera

# ROS 2 DDS 域；同一机器人上的容器和宿主机应保持一致
ROS_DOMAIN_ID=0
# DDS 实现
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# 相机命名空间 ID，最终话题前缀为 /my_camera
CAMERA_ID=my_camera
# 容器内相机配置文件
CAMERA_CONFIG_FILE=/opt/ros2_ws/deploy/basler_camera/config/aca2500_106611_18.yaml
# GigE MTU；网络和相机均支持 Jumbo Frame 时可改为 8192
CAMERA_MTU_SIZE=1500
# Basler 用户配置集：Default、CurrentSetting、UserSet1 等
CAMERA_STARTUP_USER_SET=Default
# 节点退出后是否由 launch 重启
CAMERA_RESPAWN=true
